# Copy this file to .env and fill it in. The .env file is ignored by git. Never commit a token.

# Your Jira site. Cloud looks like https://your-company.atlassian.net
JIRA_BASE_URL=

# Jira Cloud: your login email and an API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# Jira Server or Data Center instead: a personal access token from your Jira profile. Leave the two lines above empty.
# JIRA_PAT=

# Optional. Set to 1 to make every Jira write fail, whatever the office config says.
# JIRA_READ_ONLY=1
